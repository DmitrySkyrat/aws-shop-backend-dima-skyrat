# ── Build artifacts ──────────────────────────────────────────────────────────
# Generated by "npm run build" / "nest build". Rebuilt inside Docker; including
# this would bloat the build context and might contain stale/wrong-platform JS.
dist/

# ── Dependencies ─────────────────────────────────────────────────────────────
# Largest directory in the project (~300 MB+). Docker installs deps from
# package-lock.json directly inside the image, so the host copy is never needed.
node_modules/

# ── CDK output ───────────────────────────────────────────────────────────────
# Synthesized CloudFormation templates and Lambda bundles produced by "cdk synth".
# These are AWS-deployment artefacts unrelated to the Docker image.
cdk.out/

# ── Lambda packaging ─────────────────────────────────────────────────────────
# Staging folder used when bundling the Lambda zip for CDK.
# Contains another node_modules copy and the compiled handler code.
lambda-pkg/

# ── Test coverage ────────────────────────────────────────────────────────────
# HTML/JSON reports from Jest --coverage. Not needed at runtime.
coverage/
.nyc_output/

# ── Logs ─────────────────────────────────────────────────────────────────────
# npm debug logs and application logs are generated at runtime, not baked in.
logs/
*.log
npm-debug.log*
yarn-debug.log*

# ── Git history ───────────────────────────────────────────────────────────────
# The entire VCS metadata (~tens of MB on active repos).
# Docker does not need git history to build or run the app.
.git/
.gitignore

# ── Editor / OS artefacts ────────────────────────────────────────────────────
# IDE project files and macOS metadata files. No runtime value.
.DS_Store
.idea/
.vscode/

# ── Environment files ─────────────────────────────────────────────────────────
# Local .env files contain secrets (DB passwords, etc.) and must never be
# baked into a Docker image; environment variables should be injected at
# runtime (eb --envvars / ECS task definition / etc.).
.env
.env.*
!env.example

# ── SSL / TLS certificates ────────────────────────────────────────────────────
# The global-bundle.pem downloaded for local psql access. The production app
# uses sslmode=require and lets the pg driver use its own CA bundle.
*.pem

# ── Misc ──────────────────────────────────────────────────────────────────────
# Shell helper scripts used locally; not needed inside the container.
get-token.sh
